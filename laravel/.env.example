APP_NAME="BukSU Guidance"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
DB_CONNECTION=mongodb
MONGODB_URI="mongodb://127.0.0.1:27028/?replicaSet=guidance"
MONGODB_DATABASE=buksu_guidance
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=warning

INERTIA_ENCRYPT_HISTORY=true
